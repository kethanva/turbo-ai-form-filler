{
  "manifest_version": 3,
  "name": "form-autopilot",
  "version": "1.0.0",
  "description": "AI-powered form filler for job applications. Works on LinkedIn, Workday, Greenhouse, Lever, Ashby and more.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Fill form with AI"
    }
  },
  "host_permissions": [
    "https://api.groq.com/*",
    "https://router.huggingface.co/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "config/personals.json",
        "config/questions.json",
        "config/secrets.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}